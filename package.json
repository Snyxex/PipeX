{
  "name": "@snyxex/pipex",
  "version": "1.0.2",
  "description": "Composable compression, authenticated encryption, and HMAC transformation pipelines for Node.js buffers, files, and streams.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run build && npm run test:tooling && npm run test:unit && npm run test:integration && npm run test:security && npm run test:package:built && npm run test:consumer:built",
    "test:tooling": "node scripts/run-test-suite.mjs --timeout=10000 test/tooling",
    "test:unit": "node scripts/run-test-suite.mjs --timeout=15000 test/unit",
    "test:integration": "node scripts/run-test-suite.mjs --timeout=20000 test/integration",
    "test:security": "node scripts/run-test-suite.mjs --timeout=30000 test/security",
    "test:package": "npm run build && npm run test:package:built",
    "test:package:built": "node scripts/run-test-suite.mjs --timeout=30000 test/package",
    "test:consumer": "npm run build && npm run test:consumer:built",
    "test:consumer:built": "node scripts/run-test-suite.mjs --timeout=120000 test/consumer",
    "test:consumer:github": "node scripts/verify-github-consumer.mjs",
    "test:hardening": "npm run test:security",
    "test:performance": "npm run build && npm run test:performance:built",
    "test:performance:built": "node scripts/run-test-suite.mjs --timeout=15000 test/performance",
    "quality:ci": "npm run typecheck && npm run build && npm run test:tooling && npm run test:unit && npm run test:integration && npm run test:security && npm run test:package:built && npm run test:consumer:built && npm run test:performance:built && npm run test:dual-package",
    "benchmark:large": "npm run build && node scripts/run-test-suite.mjs --suffix=.benchmark.mjs --timeout=600000 benchmarks",
    "typecheck": "npm run typecheck:prod && npm run typecheck:types",
    "typecheck:types": "tsc -p tsconfig.types.json --noEmit",
    "typecheck:prod": "tsc -p tsconfig.prod.json --noEmit",
    "build": "tsdown --minify",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:dual-package": "node scripts/verify-dual-package.mjs",
    "lint:ci": "node scripts/lint-ci.mjs",
    "typecheck:ci": "tsc -p tsconfig.ci-types.json --noEmit",
    "test:vitest": "vitest run",
    "coverage:vitest": "vitest run --coverage",
    "test:examples": "node scripts/verify-examples.mjs"
  },
  "keywords": [
    "data-transformation",
    "nodejs",
    "typescript",
    "streams",
    "compression",
    "gzip",
    "brotli",
    "encryption",
    "aes-256-gcm",
    "chacha20-poly1305",
    "hmac",
    "messagepack",
    "pipeline"
  ],
  "author": "Snyxex",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "koffi": "3.3.2",
    "msgpackr": "^1.11.9",
    "piscina": "^5.2.0",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compression": {
      "types": "./dist/compression.d.mts",
      "import": {
        "types": "./dist/compression.d.mts",
        "default": "./dist/compression.mjs"
      },
      "require": {
        "types": "./dist/compression.d.cts",
        "default": "./dist/compression.cjs"
      }
    },
    "./encryption": {
      "types": "./dist/encryption.d.mts",
      "import": {
        "types": "./dist/encryption.d.mts",
        "default": "./dist/encryption.mjs"
      },
      "require": {
        "types": "./dist/encryption.d.cts",
        "default": "./dist/encryption.cjs"
      }
    },
    "./hashing": {
      "types": "./dist/hashing.d.mts",
      "import": {
        "types": "./dist/hashing.d.mts",
        "default": "./dist/hashing.mjs"
      },
      "require": {
        "types": "./dist/hashing.d.cts",
        "default": "./dist/hashing.cjs"
      }
    },
    "./validation": {
      "types": "./dist/validation.d.mts",
      "import": {
        "types": "./dist/validation.d.mts",
        "default": "./dist/validation.mjs"
      },
      "require": {
        "types": "./dist/validation.d.cts",
        "default": "./dist/validation.cjs"
      }
    },
    "./parallel": {
      "types": "./dist/parallel.d.mts",
      "import": {
        "types": "./dist/parallel.d.mts",
        "default": "./dist/parallel.mjs"
      },
      "require": {
        "types": "./dist/parallel.d.cts",
        "default": "./dist/parallel.cjs"
      }
    },
    "./native": {
      "types": "./dist/native.d.mts",
      "import": {
        "types": "./dist/native.d.mts",
        "default": "./dist/native.mjs"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    },
    "./plugins/kms": {
      "types": "./dist/kms.d.mts",
      "import": {
        "types": "./dist/kms.d.mts",
        "default": "./dist/kms.mjs"
      },
      "require": {
        "types": "./dist/kms.d.cts",
        "default": "./dist/kms.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snyxex/PipeX.git"
  },
  "homepage": "https://github.com/Snyxex/PipeX#readme",
  "bugs": {
    "url": "https://github.com/Snyxex/PipeX/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "module": "./dist/index.mjs"
}
