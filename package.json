{
  "name": "pipex",
  "version": "0.1.0",
  "description": "PipeX — A lightweight, modular data transformation engine. Effortlessly chain compression, encryption, and hashing through a unified stream-based architecture.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "npm run typecheck && npm run build && npm run test:unit && npm run test:security && npm run test:package",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.mjs",
    "test:security": "node test/hardening.test.mjs",
    "test:package": "npm run build && node --test test/package/*.test.mjs",
    "test:hardening": "npm run test:security",
    "test:performance": "npm run build && node --test test/performance/*.test.mjs",
    "typecheck": "npm run typecheck:prod",
    "typecheck:prod": "tsc -p tsconfig.prod.json --noEmit",
    "build": "tsdown --minify",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "data",
    "engine",
    "hashing",
    "compression",
    "encryption",
    "binary",
    "transformation"
  ],
  "author": "Snyxex",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "msgpackr": "^1.11.9",
    "piscina": "^5.2.0",
    "zod": "^4.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugins/kms": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist", "LICENSE", "README.md", "docs"],
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
