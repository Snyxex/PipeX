pipeline {
  agent { label 'linux' }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 3, unit: 'MINUTES')
    skipDefaultCheckout(true)
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  // Standalone trusted job: restrict Job/Build to release maintainers and
  // the protected npm-publishing job. Never grant a PR build access.
  // Pin Pipeline-from-SCM to main, not a user-supplied SCM ref.
  parameters {
    string(name: 'RELEASE_VERSION', defaultValue: '', description: 'Exact npm version; empty for initial bootstrap')
  }

  stages {
    stage('Checkout trusted main') {
      steps {
        checkout scm
        sh '''
          set -eu
          git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
          git merge-base --is-ancestor HEAD refs/remotes/origin/main
          test -f scripts/notify-discord.mjs
        '''
      }
    }

    stage('Notify verified npm release') {
      when { expression { params.RELEASE_VERSION?.trim() } }
      steps {
        withEnv(['DISCORD_EVENT_KIND=npm-release']) {
          withCredentials([string(credentialsId: 'pipex-discord-npm-release', variable: 'DISCORD_WEBHOOK_URL')]) {
            sh '''
              set +x
              mise exec node@24 -- node scripts/notify-discord.mjs
            '''
          }
        }
      }
    }
  }
}
