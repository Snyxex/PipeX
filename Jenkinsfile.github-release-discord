pipeline {
  agent { label 'linux' }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 3, unit: 'MINUTES')
    skipDefaultCheckout(true)
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  // Requires Generic Webhook Trigger and a Jenkins Secret text credential
  // named pipex-github-release-trigger-token.
  // Create as a standalone Pipeline-from-SCM job pinned to main.
  triggers {
    GenericTrigger(
      genericVariables: [
        [key: 'GH_ACTION', value: '$.action', expressionType: 'JSONPath'],
        [key: 'GH_REPO', value: '$.repository.full_name', expressionType: 'JSONPath'],
        [key: 'RELEASE_TAG', value: '$.release.tag_name', expressionType: 'JSONPath'],
        [key: 'GH_RELEASE_ID', value: '$.release.id', expressionType: 'JSONPath']
      ],
      causeString: 'Published GitHub release',
      tokenCredentialId: 'pipex-github-release-trigger-token',
      printContributedVariables: false,
      printPostContent: false,
      silentResponse: true,
      regexpFilterText: '$GH_ACTION|$GH_REPO',
      regexpFilterExpression: '^published\\|Snyxex/PipeX$'
    )
  }

  stages {
    stage('Checkout trusted main') {
      steps {
        checkout scm
        sh '''
          set -eu
          git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
          git merge-base --is-ancestor HEAD refs/remotes/origin/main
          test -f scripts/notify-discord.mjs
        '''
      }
    }

    stage('Notify published GitHub release') {
      when { expression { env.GH_ACTION == 'published' && env.GH_REPO == 'Snyxex/PipeX' } }
      steps {
        withEnv(['DISCORD_EVENT_KIND=github-release']) {
          withCredentials([string(credentialsId: 'pipex-discord-github-release', variable: 'DISCORD_WEBHOOK_URL')]) {
            sh '''
              set +x
              mise exec node@24 -- node scripts/notify-discord.mjs
            '''
          }
        }
      }
    }
  }
}
